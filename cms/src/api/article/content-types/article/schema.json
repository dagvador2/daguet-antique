{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "excerpt": {
      "type": "text",
      "required": true,
      "maxLength": 300
    },
    "body": {
      "type": "blocks",
      "required": true
    },
    "cover_image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "tags": {
      "type": "json"
    },
    "category": {
      "type": "enumeration",
      "enum": ["expertise", "savoir-faire", "coulisses", "marche"],
      "required": true
    },
    "language": {
      "type": "enumeration",
      "enum": ["fr", "en"],
      "default": "fr",
      "required": true
    },
    "related_pieces": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::piece.piece"
    },
    "seo_keywords": {
      "type": "text"
    },
    "seo_description": {
      "type": "text"
    },
    "title_en": {
      "type": "string"
    },
    "excerpt_en": {
      "type": "text"
    },
    "body_en": {
      "type": "blocks"
    },
    "seo_description_en": {
      "type": "text"
    }
  }
}
