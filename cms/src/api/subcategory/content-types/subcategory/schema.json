{
  "kind": "collectionType",
  "collectionName": "subcategories",
  "info": {
    "singularName": "subcategory",
    "pluralName": "subcategories",
    "displayName": "Subcategory"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "category": {
      "type": "enumeration",
      "enum": ["antiquite", "creation"],
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "pieces": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::piece.piece",
      "mappedBy": "subcategory"
    }
  }
}
